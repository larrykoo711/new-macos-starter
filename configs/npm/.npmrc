# =============================================================================
# npm / pnpm Configuration
# =============================================================================
# 部署到 ~/.npmrc 后对所有 npm/pnpm/yarn 操作生效
#
# 国际/默认环境（保持注释即可）：
registry=https://registry.npmjs.org/

# 中国网络环境（取消注释下方两行，注释掉上方 registry）：
# registry=https://registry.npmmirror.com/
# disturl=https://npmmirror.com/dist

# =============================================================================
# 通用配置
# =============================================================================

# 安装时显示进度条
progress=true

# 自动保存到 dependencies / devDependencies
save=true
save-exact=false

# 安全：跳过 scripts（如需运行 prepare 等钩子，按需开启）
# ignore-scripts=true

# pnpm 专用 store 路径（避免占用项目空间）
# store-dir=~/.pnpm-store

# =============================================================================
# 镜像加速备选
# =============================================================================
# 部分二进制下载（如 sharp、puppeteer）需要单独镜像：
# sharp_binary_host=https://npmmirror.com/mirrors/sharp
# sharp_libvips_binary_host=https://npmmirror.com/mirrors/sharp-libvips
# puppeteer_download_host=https://npmmirror.com/mirrors
# electron_mirror=https://npmmirror.com/mirrors/electron/
# sass_binary_site=https://npmmirror.com/mirrors/node-sass
# phantomjs_cdnurl=https://npmmirror.com/mirrors/phantomjs
